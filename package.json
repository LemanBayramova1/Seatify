{
  "name": "seatify",
  "private": true,
  "workspaces": [
    "front"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=front",
    "build": "npm run build --workspace=front",
    "dev:backend": "dotnet run --project backend",
    "dev:full": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
