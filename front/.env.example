# The C# .NET API (backend/), default "http" launch profile port.
VITE_API_URL="http://localhost:5071/api"

# "false" switches every apiService.js function from its localStorage mock
# branch to the real axios call against VITE_API_URL, and realtimeBus.js from
# the cross-tab BroadcastChannel simulation to a real SignalR connection.
VITE_USE_MOCKS="true"

# Optional: set a Stripe TEST publishable key to render the real Stripe
# Elements PaymentElement in the booking modal. Leave unset to use the
# built-in mock card form instead.
VITE_STRIPE_PUBLISHABLE_KEY=""

# Google OAuth Client ID for "Continue with Google" (Google Identity Services).
# This is a public identifier, safe to ship in client-side code.
VITE_GOOGLE_CLIENT_ID=""
